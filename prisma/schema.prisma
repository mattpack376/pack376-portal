generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEN
  ATTENDANCE_ADMIN
  JUNIOR_ADMIN
  PHOTOGRAPHER
  PARENT
}

enum DeadlineCategory {
  CAMPING
  DAY_TRIP
  SPECIAL_EVENT
  GENERAL
}

enum Rank {
  LION
  TIGER
  WOLF
  BEAR
  WEBELOS
  AOL
}

enum AdventureType {
  REQUIRED
  ELECTIVE
}

enum MeetingStatus {
  SCHEDULED
  NO_MEETING
}

enum ConsentStatus {
  PENDING
  CONSENT
  DECLINE
}

enum SignerRelationship {
  PARENT
  GUARDIAN
  GRANDPARENT
  AUNT_UNCLE
  ADULT_SIBLING
}

model User {
  id                       String                   @id @default(cuid())
  username                 String                   @unique
  passwordHash             String
  role                     Role
  email                    String?
  phone                    String?
  displayName              String
  failedLoginCount         Int                      @default(0)
  lockedUntil              DateTime?
  // Bumped whenever the account's password, role, or den assignments change.
  // The value is embedded in the session JWT; a mismatch on any protected
  // request invalidates already-issued tokens (see src/lib/auth.ts).
  sessionVersion           Int                      @default(0)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  advancementUpdates       AdvancementRecord[]
  attendanceUpdates        Attendance[]
  duesPaymentsLogged       DuesPayment[]
  denAssignments           DenAssignment[]
  resetTokens              PasswordResetToken[]
  // A PARENT-role account may link to more than one Parent contact row (one
  // per scout) when siblings share the same parent/guardian.
  parentContacts           Parent[]
  announcements            Announcement[]
  eventPaymentsLogged      EventPayment[]
  guestGroupsAdded         EventGuestGroup[]        @relation("GuestGroupAddedBy")
  guestGroupsGuestOf       EventGuestGroup[]        @relation("GuestGroupGuestOf")
  guestGroupPaymentsLogged EventGuestGroupPayment[]
  tripPaymentsLogged       TripPayment[]
}

/**
 * One-time, expiring tokens used both for new-account invites and password
 * resets, so a real password is never generated server-side, emailed, or
 * shown on screen — the account holder always sets it themselves via the
 * link. Only tokenHash is stored; the plaintext token lives in the emailed
 * or displayed URL and is never persisted (see src/lib/resetTokens.ts).
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Den {
  id             String          @id @default(cuid())
  rank           Rank
  scoutingYear   String
  label          String          @default("")
  scouts         Scout[]
  denAssignments DenAssignment[]
  createdAt      DateTime        @default(now())

  @@unique([rank, scoutingYear, label])
}

model DenAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  denId  String
  den    Den    @relation(fields: [denId], references: [id], onDelete: Cascade)

  @@unique([userId, denId])
}

model Scout {
  id                    String              @id @default(cuid())
  denId                 String
  den                   Den                 @relation(fields: [denId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  // BSA member ID (a.k.a. Scouter ID#). Not collected when a leader adds a
  // scout from the den roster — only editable from the admin Users → Scouts
  // screen, since it's office paperwork, not something a den leader tracks.
  scouterId             String?
  // Date this scout's BSA registration lapses. Same admin-only screen as
  // scouterId — not part of the quick den add-scout flow.
  registrationExpiresOn DateTime?           @db.Date
  notes                 String?
  createdAt             DateTime            @default(now())
  records               AdvancementRecord[]
  attendances           Attendance[]
  duesPayments          DuesPayment[]
  parents               Parent[]
  photoConsent          PhotoConsent?
  eventRegistrations    EventRegistration[]
  guestGroupsGuestOf    EventGuestGroup[]
}

model Parent {
  id        String   @id @default(cuid())
  scoutId   String
  scout     Scout    @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  // Set once an admin invites this contact to the Parent Portal. Nulled out
  // (not cascaded) if that login is ever deleted, so the contact info on file
  // survives losing portal access.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Adventure {
  id        String              @id @default(cuid())
  rank      Rank
  name      String
  type      AdventureType
  sortOrder Int
  note      String?
  records   AdvancementRecord[]

  @@unique([rank, name])
}

model AdvancementRecord {
  id              String    @id @default(cuid())
  scoutId         String
  scout           Scout     @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  adventureId     String
  adventure       Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  completed       Boolean   @default(false)
  completedDate   DateTime?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  updatedByUser   User?     @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([scoutId, adventureId])
}

model MeetingDate {
  id          String        @id @default(cuid())
  date        DateTime      @unique @db.Date
  status      MeetingStatus @default(SCHEDULED)
  attendances Attendance[]
}

model Attendance {
  id              String      @id @default(cuid())
  scoutId         String
  scout           Scout       @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  meetingDateId   String
  meetingDate     MeetingDate @relation(fields: [meetingDateId], references: [id], onDelete: Cascade)
  present         Boolean
  updatedAt       DateTime    @updatedAt
  updatedByUserId String?
  updatedByUser   User?       @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([scoutId, meetingDateId])
}

model DuesSettings {
  id           String   @id @default(cuid())
  scoutingYear String   @unique
  amountCents  Int
  updatedAt    DateTime @updatedAt
}

model DuesPayment {
  id               String   @id @default(cuid())
  scoutId          String
  scout            Scout    @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  amountCents      Int
  paidOn           DateTime @db.Date
  note             String?
  createdAt        DateTime @default(now())
  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
}

/**
 * Per-scout photo release, reachable only via the plaintext `token` embedded
 * in a link (no family portal accounts). It's an unguessable capability URL
 * (crypto-random, same trust level as PhotoAlbum.photoAlbumUrl below), not a
 * login credential, so storing it in plaintext is fine — but unlike that URL,
 * this one gates a write (whether photos of a specific kid can be posted
 * publicly), so it can't stay valid forever the way a read-only album link
 * can. submitPhotoConsentAction rotates `token` every time consent is
 * recorded, so a given link is good for exactly one submission; a leader
 * reopens it before that to check status, and generates a fresh one (see
 * regeneratePhotoConsentTokenAction) for the parent to make a later change.
 * PhotoConsentHistory keeps an append-only record of every submission.
 */
model PhotoConsent {
  id                 String                @id @default(cuid())
  scoutId            String                @unique
  scout              Scout                 @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  token              String                @unique
  facebook           ConsentStatus         @default(PENDING)
  website            ConsentStatus         @default(PENDING)
  fliers             ConsentStatus         @default(PENDING)
  signedByName       String?
  signedRelationship SignerRelationship?
  signedDate         DateTime?             @db.Date
  signedAt           DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  history            PhotoConsentHistory[]
}

/**
 * Append-only log of every photo-consent submission, oldest first via createdAt. Never updated or deleted directly — only ever inserted into, alongside the PhotoConsent row it snapshots and a token rotation.
 */
model PhotoConsentHistory {
  id                 String             @id @default(cuid())
  photoConsentId     String
  photoConsent       PhotoConsent       @relation(fields: [photoConsentId], references: [id], onDelete: Cascade)
  facebook           ConsentStatus
  website            ConsentStatus
  fliers             ConsentStatus
  signedByName       String
  signedRelationship SignerRelationship
  signedDate         DateTime           @db.Date
  signedAt           DateTime
  createdAt          DateTime           @default(now())

  @@index([photoConsentId])
}

model PhotoAlbum {
  id            String   @id @default(cuid())
  title         String
  eventDate     DateTime @db.Date
  description   String?
  coverImageUrl String?
  photoAlbumUrl String
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/**
 * Pack-wide notice shown to every family on the Parent Dashboard.
 */
model Announcement {
  id              String   @id @default(cuid())
  title           String
  body            String
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

/**
 * A due date surfaced on the Parent Dashboard — camping/day-trip/event RSVPs, forms, etc.
 */
model Deadline {
  id          String           @id @default(cuid())
  title       String
  category    DeadlineCategory @default(GENERAL)
  dueDate     DateTime         @db.Date
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/**
 * An open pack-wide volunteer ask shown on the Parent Dashboard.
 */
model VolunteerNeed {
  id          String   @id @default(cuid())
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * A "ticket" in the public homepage's Upcoming Attractions list. dateLabel is
 * free text (e.g. "Oct 9–12", "Nov 7 or 8") since pack events don't always
 * fit a single calendar date; sortDate drives ordering and lets past events
 * drop off the homepage on their own.
 */
model HomepageEvent {
  id          String   @id @default(cuid())
  dateLabel   String
  title       String
  description String?
  sortDate    DateTime @db.Date
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * A short, urgent notice shown in a black-and-red banner at the top of the
 * public homepage. Only the most recently created active row is displayed —
 * this isn't a list of posts, just a way to swap the current message.
 */
model SiteBanner {
  id        String    @id @default(cuid())
  message   String
  active    Boolean   @default(true)
  // Optional scheduling window (UTC instants; entered/displayed in the pack's
  // America/New_York local time — see src/lib/bannerSchedule.ts). A banner
  // with both null is a "default" banner: it only shows when no scheduled
  // banner is currently within its window. See getActiveSiteBanner.
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/**
 * A paid pack event (campout, day trip, special event) that scouts sign up for.
 */
model Event {
  id                 String              @id @default(cuid())
  title              String
  category           DeadlineCategory    @default(GENERAL)
  eventDate          DateTime            @db.Date
  description        String?
  // Default per-scout cost applied when registering a scout — null means the
  // fee is decided per registration (e.g. varies by family or trip length).
  // Also gates parent self-service: a parent can only register their own
  // scout for an event when this is set, since self-service always uses the
  // default (an admin can still register scouts at a custom amount when null).
  feeCents           Int?
  // Per-head default used to compute a guest group's suggested amount owed
  // (adultCount * adultFeeCents) — null means adult guests can't
  // self-register and an admin sets the group's amount manually.
  adultFeeCents      Int?
  // Same idea as adultFeeCents, but per guest child (childCount *
  // guestChildFeeCents) — null means guest children can't self-register.
  guestChildFeeCents Int?
  // Hides the event from parent/leader self-registration (Parent Dashboard,
  // Family View) without deleting it — admins still see and manage it, and
  // anyone already registered keeps their existing registration/balance.
  visible            Boolean             @default(true)
  // Uploaded flyer (image or PDF), stored in Vercel Blob — shown on the
  // Parent Dashboard / Family View "Upcoming Events" list so families can
  // see event details without one being open for registration.
  flyerUrl           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  registrations      EventRegistration[]
  guestGroups        EventGuestGroup[]
}

/**
 * A scout signed up for an Event, with the amount they owe for it.
 */
model EventRegistration {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scoutId         String
  scout           Scout          @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  amountOwedCents Int
  createdAt       DateTime       @default(now())
  payments        EventPayment[]

  @@unique([eventId, scoutId])
}

model EventPayment {
  id                  String            @id @default(cuid())
  eventRegistrationId String
  eventRegistration   EventRegistration @relation(fields: [eventRegistrationId], references: [id], onDelete: Cascade)
  amountCents         Int
  paidOn              DateTime          @db.Date
  note                String?
  createdAt           DateTime          @default(now())
  recordedByUserId    String?
  recordedByUser      User?             @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
}

/**
 * A family's or leader's guests attending an Event, tracked as one group —
 * a name (e.g. "The Smith Family" or a den leader's own name) plus a
 * headcount of adults and kids, not individually named. One combined amount
 * owed covers the whole group, independent of any scout's EventRegistration
 * since a group isn't necessarily tied to one specific scout in a
 * multi-sibling family (or to any scout at all — e.g. a leader's own guests,
 * or an outside family with no scout on the roster). addedByUserId records
 * which portal account added the group, so that account can edit/remove its
 * own entry but not someone else's. guestOfScoutId/guestOfUserId is a
 * separate, admin-set concept — who the group is attending *with* (a scout
 * or a leader/admin) — used to group guests by family across events; exactly
 * one, or neither (an outside family with no scout/leader link), is set.
 */
model EventGuestGroup {
  id              String                   @id @default(cuid())
  eventId         String
  event           Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  familyName      String
  adultCount      Int                      @default(0)
  childCount      Int                      @default(0)
  amountOwedCents Int
  createdAt       DateTime                 @default(now())
  addedByUserId   String?
  addedByUser     User?                    @relation("GuestGroupAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  guestOfScoutId  String?
  guestOfScout    Scout?                   @relation(fields: [guestOfScoutId], references: [id], onDelete: SetNull)
  guestOfUserId   String?
  guestOfUser     User?                    @relation("GuestGroupGuestOf", fields: [guestOfUserId], references: [id], onDelete: SetNull)
  payments        EventGuestGroupPayment[]
}

model EventGuestGroupPayment {
  id                String          @id @default(cuid())
  eventGuestGroupId String
  eventGuestGroup   EventGuestGroup @relation(fields: [eventGuestGroupId], references: [id], onDelete: Cascade)
  amountCents       Int
  paidOn            DateTime        @db.Date
  note              String?
  createdAt         DateTime        @default(now())
  recordedByUserId  String?
  recordedByUser    User?           @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
}

enum TripAffiliation {
  PACK
  TROOP
}

enum TripDay {
  FRIDAY
  SATURDAY
  SUNDAY
  MONDAY
}

enum TripMealType {
  BREAKFAST
  LUNCH
  DINNER
}

/**
 * Content + registration for a single standalone camping-trip micro-site,
 * served on its own subdomain (e.g. conron.pack376nyc.org, masked onto
 * /camp-conron by proxy.ts) with no portal login required to view or
 * register — unlike Event/EventGuestGroup above, which are entirely behind
 * portal auth. One row per trip, looked up by a fixed slug via
 * getOrCreateTripPage() in tripPageData.ts.
 */
model TripPage {
  id                       String             @id @default(cuid())
  slug                     String             @unique
  title                    String
  location                 String?
  startDate                DateTime?          @db.Date
  endDate                  DateTime?          @db.Date
  flyerUrl                 String?
  detailsHtml              String?
  regularPriceCents        Int                @default(0)
  earlyBirdPriceCents      Int?
  earlyBirdDeadline        DateTime?          @db.Date
  rsvpDeadline             DateTime?          @db.Date
  freeAgeAndUnder          Int?
  packPaymentInstructions  String?
  troopPaymentInstructions String?
  published                Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  registrations            TripRegistration[]
  meals                    TripMeal[]
  dutySlots                TripDutySlot[]
  activities               TripActivity[]
}

/**
 * A family/group's public sign-up for a TripPage — no account required.
 * payingCount/freeCount (not individually named, same convention as
 * EventGuestGroup's adult/child counts) drive amountOwedCents, frozen at
 * whichever price tier (regular vs. early-bird) was active at submit time.
 */
model TripRegistration {
  id              String          @id @default(cuid())
  tripPageId      String
  tripPage        TripPage        @relation(fields: [tripPageId], references: [id], onDelete: Cascade)
  familyName      String
  contactEmail    String
  contactPhone    String?
  affiliation     TripAffiliation
  payingCount     Int             @default(0)
  freeCount       Int             @default(0)
  amountOwedCents Int
  createdAt       DateTime        @default(now())
  payments        TripPayment[]
}

model TripPayment {
  id                 String           @id @default(cuid())
  tripRegistrationId String
  tripRegistration   TripRegistration @relation(fields: [tripRegistrationId], references: [id], onDelete: Cascade)
  amountCents        Int
  paidOn             DateTime         @db.Date
  note               String?
  createdAt          DateTime         @default(now())
  recordedByUserId   String?
  recordedByUser     User?            @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
}

/**
 * One of the trip's 8 fixed meal slots (Fri Dinner, Sat/Sun each B+L+D, Mon
 * Breakfast) — seeded automatically by getOrCreateTripPage(), never
 * created/deleted by admins, just edited (menuText) and optionally staffed
 * (dutySlots).
 */
model TripMeal {
  id         String         @id @default(cuid())
  tripPageId String
  tripPage   TripPage       @relation(fields: [tripPageId], references: [id], onDelete: Cascade)
  day        TripDay
  mealType   TripMealType
  menuText   String?
  sortOrder  Int
  dutySlots  TripDutySlot[]

  @@unique([tripPageId, day, mealType])
}

/**
 * A duty roster entry — assignedName is free text rather than a User/Scout
 * FK, since duty helpers won't all be the person who submitted the public
 * RSVP. tripMealId is optional: set for meal-prep duty, null for a
 * standalone duty (e.g. "Sunday breakdown crew") not tied to a specific meal.
 */
model TripDutySlot {
  id           String    @id @default(cuid())
  tripPageId   String
  tripPage     TripPage  @relation(fields: [tripPageId], references: [id], onDelete: Cascade)
  tripMealId   String?
  tripMeal     TripMeal? @relation(fields: [tripMealId], references: [id], onDelete: SetNull)
  label        String
  assignedName String?
  arriveTime   String?
  notes        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
}

/**
 * One line of the weekend's itinerary — a day + free-text time (e.g. "4:00
 * PM" or "After breakfast") plus a title/description, shown on both the
 * public page and the admin editor as a simple chronological schedule.
 * sortOrder exists for future manual reordering (same convention as
 * TripDutySlot) but isn't exposed as an admin input yet — display order is
 * day, then sortOrder, then creation order.
 */
model TripActivity {
  id          String   @id @default(cuid())
  tripPageId  String
  tripPage    TripPage @relation(fields: [tripPageId], references: [id], onDelete: Cascade)
  day         TripDay
  time        String?
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
