# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Google service-account key files (the Ledger's Sheet sync). The key goes in
# Vercel's environment variables only; keep the downloaded file outside this
# folder, and never commit it — this repo is public.
*service-account*.json
*-sa-key*.json
pack376-portal-*.json
# Google's own name for a downloaded key: <project-id>-<12 hex digits>.json.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Local security-review write-ups and reproduction scripts. Never commit
# them — this repo is public.
/security-review-*/
