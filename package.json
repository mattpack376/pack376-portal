{
  "name": "pack376-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --import tsx --import ./tests/support/hooks.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:db": "node scripts/test-db.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/firewall": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "^6.17.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.5",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "@vercel/blob": {
      "undici": "^6.29.1"
    }
